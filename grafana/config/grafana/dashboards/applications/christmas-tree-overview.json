{
  "uid": "christmas-tree-overview",
  "title": "Christmas Tree — Overview",
  "tags": [
    "christmas-tree",
    "mvp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests /s by route",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (route, status) (rate(christmas_tree_http_requests_total[5m]))",
          "legendFormat": "{{route}} → {{code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(christmas_tree_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(christmas_tree_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(christmas_tree_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Orders created (total)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(christmas_tree_orders_total)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Orders PAID (total)",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(christmas_tree_orders_paid_total)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Payment conversion",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(christmas_tree_orders_paid_total) / clamp_min(sum(christmas_tree_orders_total), 1)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Likes /s",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(rate(christmas_tree_likes_total[5m]))",
          "legendFormat": "likes/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "5xx error ratio",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(christmas_tree_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(christmas_tree_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    }
  ]
}